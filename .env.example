# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (NEVER expose to client - used only in server actions/scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Download do app desktop (card na pagina /arquivos) - TODAS OPCIONAIS.
# Sem nenhuma delas, o card aponta pra pagina de releases do repo no GitHub.
# Use as duas de baixo se quiser link direto pro instalador em vez da pagina.
# NEXT_PUBLIC_DESKTOP_RELEASES_URL=https://github.com/AndrewLPimenta/Step-Album/releases/latest
# NEXT_PUBLIC_DESKTOP_WINDOWS_URL=https://.../StepAlbum_0.1.0_x64_pt-BR.msi
# NEXT_PUBLIC_DESKTOP_MAC_URL=https://.../StepAlbum_0.1.0_aarch64.dmg
