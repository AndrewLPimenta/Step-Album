{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StepAlbum",
  "version": "0.1.0",
  "identifier": "com.stepalbum.desktop",
  "build": {
    "frontendDist": "../tauri-shell"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "StepAlbum",
        "url": "https://step-album.vercel.app/?desktop=1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState",
          "radius": 12.0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
